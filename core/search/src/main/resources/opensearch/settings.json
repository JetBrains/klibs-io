{
  "number_of_shards": 1,
  "number_of_replicas": 0,
  "analysis": {
    "tokenizer": { "code_tokenizer": { "type": "pattern", "pattern": "[^a-zA-Z0-9]+" } },
    "filter": {
      "tool_alias_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "hilt => koin, kodein",
          "dagger => koin, kodein",
          "glide => coil",
          "picasso => coil",
          "retrofit => ktorfit, ktor",
          "room alternative => sqldelight",
          "exposed => sqldelight",
          "gson => kotlinx.serialization",
          "moshi => kotlinx.serialization",
          "jackson => kotlinx.serialization"
        ]
      },
      "only_aliases": { "type": "keep_types", "types": ["SYNONYM"] },
      "partial_edge_ngram": { "type": "edge_ngram", "min_gram": 3, "max_gram": 18 },
      "reverse_chars": { "type": "reverse" },
      "english_possessive": { "type": "stemmer", "language": "possessive_english" },
      "english_stem": { "type": "stemmer", "language": "english" },
      "name_delimiter": {
        "type": "word_delimiter_graph",
        "split_on_case_change": true,
        "split_on_numerics": true,
        "generate_word_parts": true,
        "generate_number_parts": true,
        "catenate_words": false,
        "preserve_original": true,
        "stem_english_possessive": false
      }
    },
    "analyzer": {
      "code_split": { "type": "custom", "tokenizer": "code_tokenizer", "filter": ["lowercase"] },
      "tool_alias": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "tool_alias_synonyms", "only_aliases"]
      },
      "token_prefix": {
        "type": "custom",
        "tokenizer": "code_tokenizer",
        "filter": ["lowercase", "partial_edge_ngram"]
      },
      "token_suffix": {
        "type": "custom",
        "tokenizer": "code_tokenizer",
        "filter": ["lowercase", "reverse_chars", "partial_edge_ngram", "reverse_chars"]
      },
      "text_english": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["english_possessive", "lowercase", "english_stem"]
      },
      "name_split": {
        "type": "custom",
        "tokenizer": "whitespace",
        "filter": ["name_delimiter", "lowercase", "flatten_graph"]
      }
    }
  }
}
