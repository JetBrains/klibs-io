{
  "dynamic": "strict",
  "properties": {
    "project_id": { "type": "long" },
    "owner_type": { "type": "keyword" },
    "owner_login": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
    "repo_name": { "type": "text" },
    "name": {
      "type": "text",
      "fields": {
        "prefix": { "type": "text", "analyzer": "token_prefix", "search_analyzer": "code_split" },
        "suffix": { "type": "text", "analyzer": "token_suffix", "search_analyzer": "code_split" },
        "split": { "type": "text", "analyzer": "name_split" },
        "en": { "type": "text", "analyzer": "text_english" }
      }
    },
    "group_ids": { "type": "text", "analyzer": "code_split" },
    "artifact_ids": {
      "type": "text",
      "analyzer": "code_split",
      "fields": {
        "prefix": { "type": "text", "analyzer": "token_prefix", "search_analyzer": "code_split" },
        "suffix": { "type": "text", "analyzer": "token_suffix", "search_analyzer": "code_split" }
      }
    },
    "repo_description": {
      "type": "text",
      "fields": { "en": { "type": "text", "analyzer": "text_english" } }
    },
    "project_description": {
      "type": "text",
      "fields": { "en": { "type": "text", "analyzer": "text_english" } }
    },
    "platforms": { "type": "keyword" },
    "tags": {
      "type": "text",
      "fields": {
        "keyword": { "type": "keyword" },
        "en": { "type": "text", "analyzer": "text_english" }
      }
    },
    "markers": { "type": "keyword" },
    "targets": { "type": "keyword" },
    "stars": { "type": "integer" },
    "dependent_count": { "type": "integer" },
    "health_score": { "type": "integer" },
    "has_readme": { "type": "boolean" },
    "license_name": { "type": "keyword" },
    "latest_version": { "type": "keyword" },
    "latest_version_ts": { "type": "date" },
    "plain_description": { "type": "text", "index": false },
    "packages": {
      "type": "nested",
      "properties": {
        "group_id": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
        "artifact_id": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
        "latest_description": { "type": "text" }
      }
    }
  }
}
