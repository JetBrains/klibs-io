{
  "name": "klibs.io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "pw:check": "playwright --version",
    "pw:install": "playwright install --with-deps",
    "test:component": "vitest run --project unit",
    "test:component:watch": "vitest --project unit",
    "test:visual": "npm run uiverify:clean && vitest run --project visual",
    "test:visual:watch": "npm run uiverify:clean && vitest --project visual",
    "uiverify:clean": "node -e \"require('fs').rmSync('uiverify-archive',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@jetbrains/kotlin-web-site-ui": "^4.14.9",
    "@next/third-parties": "^16.4.5",
    "bem-cn-fast": "^1.0.2",
    "@rescui/button": "^0.27.2",
    "@rescui/card": "^0.16.3",
    "@rescui/checkbox": "^0.14.2",
    "@rescui/chip-list": "^0.17.2",
    "@rescui/dropdown-menu": "^0.15.3",
    "@rescui/focus-manager": "^0.2.0",
    "@rescui/icons": "^1.12.0",
    "@rescui/radio-button": "^0.13.2",
    "@rescui/select": "^0.22.0",
    "@rescui/switcher": "^0.16.2",
    "@rescui/tab-list": "^0.21.2",
    "@rescui/table": "^0.10.5",
    "@rescui/tag": "^0.16.2",
    "@rescui/toggle": "^0.8.2",
    "@rescui/tooltip": "^0.14.3",
    "@rescui/typography": "^0.30.2",
    "@rescui/ui-contexts": "^0.8.0",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "github-markdown-css": "^5.9.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-remove-scroll-bar": "^2.3.8",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiverify/vitest": "^1.6.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "optionalDependencies": {
    "husky": "^9.1.7"
  }
}
